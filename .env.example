# Resend — envío de correos
RESEND_API_KEY=tu-api-key-de-resend

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=tu-clave-secreta-de-turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=tu-clave-publica-de-turnstile

# Destino de los formularios
CONTACT_EMAIL=correo@ejemplo.cl

# Remitente que verá Gloria en las notificaciones del formulario
CONTACT_FROM_EMAIL=Puepu Bienestar <onboarding@resend.dev>

# Instagram API con inicio de sesión de Instagram — feed del inicio (solo servidor)
# Token de larga duración (60 días). Renovar cada ~50 días: ver README.
# Sin valor, el inicio muestra la galería estática.
INSTAGRAM_ACCESS_TOKEN=tu-token-de-larga-duracion-de-instagram

# Pública: se incrusta en el build
NEXT_PUBLIC_WHATSAPP_NUMBER=+56952541245

# URL pública del sitio (solo Production en Vercel, se define en el Paso 8)
NEXT_PUBLIC_SITE_URL=https://puepubienestar.cl
